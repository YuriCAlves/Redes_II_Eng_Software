# /etc/sudoers.d/console-n2-servicos — Parte 2 (DNS e DHCP) do Console N2.
# Instale pelo roteiro do README (visudo -cf + install); NÃO copie de PDF.
# Cada regra é um comando exato: sem curingas, sem sudo irrestrito.
# Os arquivos de /var/lib/console-n2 têm nome fixo (pasta do yuri, modo 700).

Cmnd_Alias CONSOLE_DNS = \
    /usr/bin/cat /etc/bind/db.empresa.test, \
    /usr/bin/cat /etc/bind/db.192.168.100, \
    /usr/bin/cp /var/lib/console-n2/dns-fwd.zone /etc/bind/db.empresa.test, \
    /usr/bin/cp /var/lib/console-n2/dns-rev.zone /etc/bind/db.192.168.100, \
    /usr/sbin/rndc reload empresa.test, \
    /usr/sbin/rndc reload 100.168.192.in-addr.arpa

Cmnd_Alias CONSOLE_DHCP = \
    /usr/bin/cat /etc/kea/kea-dhcp4.conf, \
    /usr/bin/cat /var/lib/kea/kea-leases4.csv, \
    /usr/bin/cp /var/lib/console-n2/kea-dhcp4.json /etc/kea/kea-dhcp4.candidate.json, \
    /usr/bin/cp /var/lib/console-n2/kea-dhcp4.json /etc/kea/kea-dhcp4.conf, \
    /usr/bin/systemctl reload-or-restart kea-dhcp4-server

# Validação do Kea como o usuário do serviço: o AppArmor do kea-dhcp4 só lê /etc/kea/**
# e /etc/kea é 750 _kea:_kea (nem o root confinado consegue abrir a pasta).
Cmnd_Alias CONSOLE_DHCP_TEST = \
    /usr/sbin/kea-dhcp4 -t /etc/kea/kea-dhcp4.candidate.json

# RADIUS (incremento 4): estado + arquivos gerados, reinício e leitura de logs por um script fixo
Cmnd_Alias CONSOLE_RADIUS = \
    /usr/bin/cat /etc/freeradius/3.0/console-n2/console-n2.json, \
    /usr/bin/cp /var/lib/console-n2/radius-state.json /etc/freeradius/3.0/console-n2/console-n2.json, \
    /usr/bin/cp /var/lib/console-n2/radius-clients.conf /etc/freeradius/3.0/console-n2/clients.conf, \
    /usr/bin/cp /var/lib/console-n2/radius-users /etc/freeradius/3.0/console-n2/users, \
    /usr/bin/systemctl restart freeradius, \
    /usr/local/sbin/console-n2-radius-read auth, \
    /usr/local/sbin/console-n2-radius-read acct

# Validação do FreeRADIUS como o usuário do serviço (lê a árvore de configuração, não grava nada)
Cmnd_Alias CONSOLE_RADIUS_TEST = \
    /usr/sbin/freeradius -XC

yuri ALL=(root) NOPASSWD: CONSOLE_DNS, CONSOLE_DHCP, CONSOLE_RADIUS
yuri ALL=(_kea) NOPASSWD: CONSOLE_DHCP_TEST
yuri ALL=(freerad) NOPASSWD: CONSOLE_RADIUS_TEST
