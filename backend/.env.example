# Copie para backend/.env (este arquivo NÃO vai para o Git) e preencha.
# Variáveis já definidas no ambiente têm prioridade sobre este arquivo.

# --- FTP (CP3) ---
CONSOLE_FTP_PASSWORD=troque-aqui
# CONSOLE_FTP_USER=ftpuser
# CONSOLE_FTP_DIR=/arquivos          # caminho visto pelo ftpuser (depende do chroot do vsftpd)
# CONSOLE_MAX_UPLOAD_MB=10

# --- E-mail (CP4): senha Linux de cada conta ---
CONSOLE_MAIL_PASS_ALUNO=troque-aqui
CONSOLE_MAIL_PASS_SUPORTE=troque-aqui

# --- SSH (CP5/CP6) ---
CONSOLE_SSH_KEY_PATH=/home/yuri/.ssh/id_ed25519_redes_n1
# CONSOLE_SSH_KEY_PASSPHRASE=        # somente se a chave tiver senha
# CONSOLE_SSH_USER=yuri
# CONSOLE_SSH_KNOWN_HOSTS=/caminho/para/known_hosts   # padrão: backend/known_hosts

# --- Outros (valores padrão já servem para a rede do projeto) ---
# CONSOLE_SERVICE_HOST=192.168.100.10
# CONSOLE_SITE_URL=http://site.empresa.test/
# CONSOLE_FILES_PUBLIC_URL=http://site.empresa.test/arquivos/
# CONSOLE_SESSION_TTL=3600
